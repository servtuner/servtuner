{"analyzer_version":"1.25.0","derivation":{"nodes":[{"bounds":{"max":2,"min":0},"default":0.2,"doc":"sizing policy","id":"h_req","kind":"parameter","label":"Request headroom over p95 usage","value":0.2},{"bounds":{"max":2,"min":0},"default":0.3,"doc":"sizing policy","id":"h_lim","kind":"parameter","label":"Limit headroom over the peak","value":0.3},{"bounds":{"min":0},"default":86400,"doc":"sizing policy: memory","id":"pod_lifetime_seconds","kind":"parameter","label":"Expected pod lifetime","unit":"s","value":86400},{"id":"rps_per_replica","kind":"measured","label":"SLO-max RPS per replica","source":{"file":"analysis.json","stage_index":3},"unit":"requests/s","value":3.914551446451663},{"bounds":{"max":0.95,"min":0},"default":0.2,"doc":"sizing policy: replicas and HPA","id":"h_rep","kind":"parameter","label":"Replica headroom under the SLO-max","value":0.2},{"bounds":{"min":1},"default":2,"doc":"sizing policy: survive a pod or node loss","id":"min_replicas","kind":"parameter","label":"Minimum replicas for availability","unit":"replicas","value":2},{"id":"queue.lambda","kind":"measured","label":"Arrival rate λ","source":{"file":"requests.parquet","stage_index":3},"unit":"requests/s","value":7},{"id":"queue.W_mean","kind":"measured","label":"Mean time a request holds a slot W (the whole E2E)","source":{"file":"requests.parquet","stage_index":3},"unit":"s","value":2.5313355428571436},{"id":"queue.W_p99","kind":"measured","label":"p99 time a request holds a slot","source":{"file":"requests.parquet","stage_index":3},"unit":"s","value":2.854888},{"id":"queue.C_emp","kind":"measured","label":"p99 of in-flight L(t)","source":{"file":"requests.parquet","stage_index":3},"unit":"requests","value":19},{"id":"queue.arrivals_p99","kind":"measured","label":"p99 arrivals in one second","source":{"file":"requests.parquet","stage_index":3},"unit":"requests","value":8},{"bounds":{"max":2,"min":1},"default":1.1,"doc":"queueing model","id":"queue.safety","kind":"parameter","label":"Safety factor on C","value":1.1},{"bounds":{"max":10,"min":1},"default":1,"doc":"queueing model assumption; RunSpec analysis.burst_factor","id":"queue.burst_factor","kind":"parameter","label":"Burst factor on B_min","value":1},{"formula":"poisson_q(0.99, queue.lambda * queue.W_mean)","id":"queue.C_pois","inputs":["queue.W_mean","queue.lambda"],"kind":"derived","label":"Poisson p99 in flight","rendered":"poisson_q(0.99, 7 × 2.53134) = 28","unit":"requests","value":28},{"formula":"ceil(queue.lambda * queue.W_p99)","id":"queue.C_cons","inputs":["queue.W_p99","queue.lambda"],"kind":"derived","label":"Conservative bound ⌈λ·p99(W)⌉","rendered":"⌈7 × 2.85489⌉ = 20","unit":"requests","value":20},{"formula":"max(1, clamp(ceil(max(queue.C_emp, queue.C_pois) * queue.safety), queue.C_emp, max(queue.C_emp, queue.C_cons)))","id":"queue.C","inputs":["queue.C_cons","queue.C_emp","queue.C_pois","queue.safety"],"kind":"derived","label":"Recommended concurrency C","rendered":"max(1, clamp(⌈max(19, 28) × 1.1⌉, 19, max(19, 20))) = 20","unit":"requests","value":20},{"formula":"queue.lambda * queue.W_mean / queue.C","id":"queue.rho","inputs":["queue.C","queue.W_mean","queue.lambda"],"kind":"derived","label":"Utilization ρ = λ·mean(W) / C","rendered":"7 × 2.53134 ÷ 20 = 0.885967","value":0.8859674400000003},{"formula":"erlang_c(queue.C, queue.lambda * queue.W_mean)","id":"queue.P_wait","inputs":["queue.C","queue.W_mean","queue.lambda"],"kind":"derived","label":"P(wait), Erlang-C (approximate)","rendered":"erlang_c(20, 7 × 2.53134) = 0.500405","value":0.5004048023462414},{"formula":"queue.C / queue.W_mean","id":"queue.mu","inputs":["queue.C","queue.W_mean"],"kind":"derived","label":"Drain rate μ = C / mean(W)","rendered":"20 ÷ 2.53134 = 7.90097","unit":"requests/s","value":7.9009675570018665},{"formula":"ceil(queue.burst_factor * max(0, queue.arrivals_p99 - queue.mu))","id":"queue.B_min","inputs":["queue.arrivals_p99","queue.burst_factor","queue.mu"],"kind":"derived","label":"B_min: p99 one-sec