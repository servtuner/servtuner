{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://servtuner.dev/schema/bundle/target-snapshot.schema.json",
  "title": "TargetSnapshot",
  "description": "target/snapshot-pre.json and target/snapshot-post.json: the target workload and each upstream, read-only, before and after the load. The two files share this schema and differ in phase.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "phase",
    "captured_at",
    "workloads"
  ],
  "properties": {
    "phase": {
      "$ref": "#/definitions/snapshotPhase"
    },
    "captured_at": {
      "$ref": "../common.schema.json#/definitions/utcTimestamp"
    },
    "workloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/workload"
      }
    }
  },
  "definitions": {
    "snapshotPhase": {
      "type": "string",
      "enum": [
        "pre",
        "post"
      ]
    },
    "workloadRole": {
      "type": "string",
      "enum": [
        "target",
        "upstream"
      ]
    },
    "resourceQuantities": {
      "description": "Kubernetes resource quantities by resource name, for example cpu, memory, nvidia.com/gpu.",
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "envVar": {
      "description": "An environment variable. A redacted one carries no value: a run never stores a secret.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "is_redacted",
            "value"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "is_redacted": {
              "const": false
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "is_redacted"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "is_redacted": {
              "const": true
            }
          }
        }
      ]
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "image"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "image_digest": {
          "description": "The resolved digest, from the pod's container status.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/envVar"
          }
        },
        "requests": {
          "$ref": "#/definitions/resourceQuantities"
        },
        "limits": {
          "$ref": "#/definitions/resourceQuantities"
        },
        "restart_count": {
          "type": "integer",
          "minimum": 0
        },
        "last_termination_reason": {
          "description": "For example OOMKilled.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "containers"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "node": {
          "type": "string",
          "minLength": 1
        },
        "containers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/container"
          }
        }
      }
    },
    "replicas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "desired",
        "ready"
      ],
      "properties": {
        "desired": {
          "type": "integer",
          "minimum": 0
        },
        "ready": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "node": {
      "description": "Labels of a node the workload runs on (instance type, GPU model).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "labels"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "hpaMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name",
        "target"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "description": "Target value as Kubernetes prints it.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hpa": {
      "description": "HorizontalPodAutoscaler of the workload. min_replicas <= max_replicas is not expressible here and is a servtuner validate rule.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "min_replicas",
        "max_replicas",
        "current_replicas"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "min_replicas": {
          "type": "integer",
          "minimum": 0
        },
        "max_replicas": {
          "type": "integer",
          "minimum": 0
        },
        "current_replicas": {
          "type": "integer",
          "minimum": 0
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/hpaMetric"
          }
        }
      }
    },
    "targetInfo": {
      "description": "What the workload reports about itself.",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "version": {
          "description": "As the workload reports it, for example vLLM /version.",
          "type": "string",
          "minLength": 1
        },
        "models": {
          "description": "Model ids from /v1/models.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cache_config": {
          "description": "vLLM cache_config_info labels.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "hardwareProfile": {
      "description": "Hardware the results are scoped to. Requires the accelerator (or none) and the node instance type or the CPU model; fields that cannot be read are omitted.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accelerator"
      ],
      "properties": {
        "hardware_profile_id": {
          "description": "Hash of the other fields.",
          "type": "string",
          "minLength": 1
        },
        "accelerator": {
          "description": "GPU model, or none when the workload has no accelerator.",
          "type": "string",
          "minLength": 1
        },
        "gpu_count_per_pod": {
          "type": "integer",
          "minimum": 0
        },
        "gpu_memory_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "gpu_interconnect": {
          "type": "string",
          "enum": [
            "nvlink",
            "pcie"
          ]
        },
        "driver_version": {
          "type": "string",
          "minLength": 1
        },
        "cuda_version": {
          "type": "string",
          "minLength": 1
        },
        "node_instance_type": {
          "description": "The cloud instance type, or local.",
          "type": "string",
          "minLength": 1
        },
        "cpu_model": {
          "type": "string",
          "minLength": 1
        },
        "cpu_cores": {
          "type": "integer",
          "minimum": 0
        }
      },
      "anyOf": [
        {
          "required": [
            "node_instance_type"
          ]
        },
        {
          "required": [
            "cpu_model"
          ]
        }
      ]
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "target_type",
        "pods"
      ],
      "properties": {
        "role": {
          "$ref": "#/definitions/workloadRole"
        },
        "upstream_index": {
          "description": "Position in the RunSpec's target.upstreams; present only when role is upstream.",
          "type": "integer",
          "minimum": 0
        },
        "target_type": {
          "$ref": "../runspec.schema.json#/definitions/targetType"
        },
        "pods": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/pod"
          }
        },
        "replicas": {
          "$ref": "#/definitions/replicas"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/node"
          }
        },
        "hpa": {
          "$ref": "#/definitions/hpa"
        },
        "target_info": {
          "$ref": "#/definitions/targetInfo"
        },
        "hardware_profile": {
          "$ref": "#/definitions/hardwareProfile"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "enum": [
                  "upstream"
                ]
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "required": [
              "upstream_index"
            ]
          },
          "else": {
            "not": {
              "required": [
                "upstream_index"
              ]
            }
          }
        }
      ]
    }
  }
}
