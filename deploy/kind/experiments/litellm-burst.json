{
  "apiVersion": "servtuner.dev/v2",
  "kind": "RunSpec",
  "name": "litellm-burst",
  "experiment": "litellm-burst",
  "target": {
    "type": "litellm",
    "endpoint": "http://kind-node.invalid:30400/v1",
    "model": "mock-model",
    "auth": {
      "secretRef": {
        "name": "servtuner-litellm-master-key",
        "key": "token"
      }
    },
    "workload": {
      "namespace": "servtuner-litellm",
      "selector": {
        "app": "servtuner-litellm"
      }
    },
    "tls": {
      "enabled": false
    }
  },
  "engine": {
    "type": "loadgen"
  },
  "workload": {
    "streaming": true,
    "dataset": {
      "type": "synthetic",
      "input_tokens": {
        "mean": 128
      },
      "output_tokens": {
        "mean": 32
      }
    },
    "seed": 42
  },
  "load": {
    "pacing": "poisson",
    "warmup": "30s",
    "stages": [
      {
        "rate": 8,
        "duration": "150s"
      },
      {
        "rate": 16,
        "duration": "150s"
      },
      {
        "rate": 40,
        "duration": "20s",
        "is_burst": true
      }
    ]
  },
  "prometheus": {
    "url": "http://127.0.0.1:19090",
    "tls": {
      "enabled": false
    }
  },
  "slos": {
    "ttft_p95": "500ms",
    "e2e_p95": "2s"
  },
  "knobs": {
    "litellm.num_workers": 1
  }
}
