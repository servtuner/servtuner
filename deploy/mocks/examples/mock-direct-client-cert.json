{
  "apiVersion": "servtuner.dev/v2",
  "kind": "RunSpec",
  "name": "mock-direct-client-cert",
  "target": {
    "type": "openai-compatible",
    "endpoint": "https://openai-mock.servtuner-mock.svc:8000/v1",
    "model": "mock-model",
    "workload": {
      "namespace": "servtuner-mock",
      "selector": {
        "app.kubernetes.io/name": "openai-mock"
      }
    },
    "tls": {
      "enabled": true,
      "clientCert": {
        "secretRef": {
          "name": "servtuner-bench-tls"
        }
      }
    }
  },
  "engine": {
    "type": "loadgen"
  },
  "workload": {
    "streaming": true,
    "dataset": {
      "type": "synthetic",
      "input_tokens": {
        "mean": 128
      },
      "output_tokens": {
        "mean": 32
      }
    }
  },
  "load": {
    "stages": [
      {
        "rate": 20,
        "duration": "150s"
      },
      {
        "rate": 50,
        "duration": "150s"
      }
    ],
    "warmup": "30s"
  },
  "prometheus": {
    "url": "http://kps-prometheus.monitoring.svc:9090",
    "tls": {
      "enabled": false
    }
  },
  "slos": {
    "ttft_p95": "500ms",
    "e2e_p95": "2s"
  }
}
