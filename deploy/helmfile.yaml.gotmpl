# servtuner and its prerequisites, each its own Helm release.
# The servtuner chart never carries the prerequisites as subcharts: each is its upstream chart, unmodified,
# upgraded and rolled back on its own, and skippable when the site already runs it.
#
#   helmfile -f deploy/helmfile.yaml.gotmpl -e <kind|airgap|eks> sync [--skip-deps]
#
# `sync` needs only helm and helmfile (no helm-diff); `apply` and `diff` need the helm-diff plugin.
# The file is a template (helmfile v1 renders only *.gotmpl), so chart sources and registries follow the
# environment: the airgap environment installs from the chart files the release carries.
environments:
  kind:
    values: [helmfile/env/common.yaml, helmfile/env/kind.yaml]
  airgap:
    values: [helmfile/env/common.yaml, helmfile/env/airgap.yaml]
  eks:
    values: [helmfile/env/common.yaml, helmfile/env/eks.yaml]
---
{{- $v := .Values }}
{{- $offlineCharts := ne $v.chartsDir "" }}
{{- if not $offlineCharts }}
repositories:
  - {name: jetstack, url: https://charts.jetstack.io}
  - {name: cnpg, url: https://cloudnative-pg.github.io/charts}
  - {name: prometheus-community, url: https://prometheus-community.github.io/helm-charts}
  - {name: envoyproxy, url: docker.io/envoyproxy, oci: true}
{{- end }}

# The prerequisites are waited for: servtuner's chart creates objects their webhooks admit (CloudNativePG's
# Cluster, cert-manager's Certificates), which fail while a webhook has no ready pod.
templates:
  prerequisite:
    wait: true
    timeout: 600

releases:
  - name: cert-manager
    inherit: [{template: prerequisite}]
    namespace: cert-manager
    installed: {{ $v.install.certManager }}
    {{- if $offlineCharts }}
    chart: {{ $v.chartsDir }}/cert-manager-{{ $v.versions.certManager }}.tgz
    {{- else }}
    chart: jetstack/cert-manager
    version: {{ $v.versions.certManager }}
    {{- end }}
    values: [helmfile/values/cert-manager.yaml.gotmpl]

  - name: cnpg
    inherit: [{template: prerequisite}]
    namespace: cnpg-system
    installed: {{ $v.install.cnpg }}
    {{- if $offlineCharts }}
    chart: {{ $v.chartsDir }}/cloudnative-pg-{{ $v.versions.cnpg }}.tgz
    {{- else }}
    chart: cnpg/cloudnative-pg
    version: {{ $v.versions.cnpg }}
    {{- end }}
    values: [helmfile/values/cnpg.yaml.gotmpl]

  - name: envoy-gateway
    inherit: [{template: prerequisite}]
    namespace: envoy-gateway-system
    installed: {{ $v.install.envoyGateway }}
    {{- if $offlineCharts }}
    chart: {{ $v.chartsDir }}/gateway-helm-{{ $v.versions.envoyGateway }}.tgz
    {{- else }}
    chart: envoyproxy/gateway-helm
    version: {{ $v.versions.envoyGateway }}
    {{- end }}
    values: [helmfile/values/envoy-gateway.yaml.gotmpl]

  - name: kube-prometheus-stack
    inherit: [{template: prerequisite}]
    namespace: monitoring
    installed: {{ $v.install.prometheus }}
    {{- if $offlineCharts }}
    chart: {{ $v.chartsDir }}/kube-prometheus-stack-{{ $v.versions.prometheus }}.tgz
    {{- else }}
    chart: prometheus-community/kube-prometheus-stack
    version: {{ $v.versions.prometheus }}
    {{- end }}
    values: [helmfile/values/kube-prometheus-stack.yaml.gotmpl]

  - name: servtuner
    namespace: {{ $v.servtunerNamespace }}
    chart: ./helm/servtuner
    # Installed after its prerequisites: the chart checks their CRDs (cert-manager, CNPG, Gateway API).
    needs:
      {{- if $v.install.certManager }}
      - cert-manager/cert-manager
      {{- end }}
      {{- if $v.install.cnpg }}
      - cnpg-system/cnpg
      {{- end }}
      {{- if $v.install.envoyGateway }}
      - envoy-gateway-system/envoy-gateway
      {{- end }}
    values:
      - helmfile/values/servtuner.yaml.gotmpl
      {{- range $v.siteValues }}
      - {{ . }}
      {{- end }}
