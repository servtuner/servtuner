{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://servtuner.dev/schema/bundle/analysis.schema.json",
  "title": "AnalysisResult",
  "description": "analysis.json: data quality gate, per-stage client aggregates and the capacity model. Recomputable from the raw files by servtuner analyze.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analyzer_version",
    "quality",
    "stages",
    "capacity"
  ],
  "properties": {
    "analyzer_version": {
      "type": "string",
      "minLength": 1
    },
    "hardware_profile_id": {
      "description": "The hardware profile the results are scoped to: hardware_profile's id.",
      "type": "string",
      "minLength": 1
    },
    "hardware_profile": {
      "description": "The hardware the results are scoped to: the target's profile from the snapshot, or, for a target outside Kubernetes, one built from the RunSpec's target.hardware (hardware_source). Absent when neither is known.",
      "$ref": "target-snapshot.schema.json#/definitions/hardwareProfile"
    },
    "hardware_source": {
      "description": "Where hardware_profile came from: captured from the Kubernetes nodes the target runs on, or declared in the RunSpec.",
      "type": "string",
      "enum": ["captured", "declared"]
    },
    "quality": {
      "$ref": "#/definitions/runQuality"
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/stageAggregate"
      }
    },
    "capacity": {
      "$ref": "#/definitions/capacityModel"
    }
  },
  "definitions": {
    "qualityGrade": {
      "type": "string",
      "enum": [
        "good",
        "degraded",
        "unusable"
      ]
    },
    "qualityIssueCode": {
      "description": "The data quality checks.",
      "type": "string",
      "enum": [
        "achieved_rps_low",
        "send_lag_high",
        "client_bound",
        "target_saturated",
        "target_stalled",
        "low_resolution",
        "config_drift",
        "knob_mismatch",
        "insufficient_samples",
        "catalog_missing",
        "series_gaps",
        "knob_unverified",
        "oom_restart",
        "burst_stage",
        "stream_batched"
      ]
    },
    "qualityIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/definitions/qualityIssueCode"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stageQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_index",
        "is_valid",
        "is_client_bound",
        "is_excluded"
      ],
      "properties": {
        "stage_index": {
          "type": "integer",
          "minimum": 0
        },
        "is_valid": {
          "description": "A trustworthy stage: achieved RPS, send lag and client_bound are all within thresholds.",
          "type": "boolean"
        },
        "is_client_bound": {
          "type": "boolean"
        },
        "is_excluded": {
          "description": "True when the stage is left out of the capacity model.",
          "type": "boolean"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/qualityIssue"
          }
        }
      }
    },
    "knobStatus": {
      "description": "verified: the target's captured value equals the declared one. mismatch: it differs, so the change was not applied. unverified: the value cannot be captured.",
      "type": "string",
      "enum": [
        "verified",
        "mismatch",
        "unverified"
      ]
    },
    "knobCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "declared",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "declared": {
          "description": "The RunSpec value, rendered as a string.",
          "type": "string"
        },
        "actual": {
          "description": "The captured value, rendered as a string; absent when unverified.",
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/knobStatus"
        }
      }
    },
    "catalogCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog",
        "is_collected"
      ],
      "properties": {
        "catalog": {
          "$ref": "../common.schema.json#/definitions/catalogName"
        },
        "is_collected": {
          "type": "boolean"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogs",
        "series_with_gaps_percent"
      ],
      "properties": {
        "catalogs": {
          "description": "Every expected catalog.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/catalogCoverage"
          }
        },
        "series_with_gaps_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "runQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grade",
        "is_excluded_from_comparison",
        "stages"
      ],
      "properties": {
        "grade": {
          "$ref": "#/definitions/qualityGrade"
        },
        "is_excluded_from_comparison": {
          "description": "True when the run must not enter experiment comparisons, for example on a knob_mismatch.",
          "type": "boolean"
        },
        "issues": {
          "description": "Run-level issues, as opposed to the stage-level ones in stages.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/qualityIssue"
          }
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/stageQuality"
          }
        },
        "knobs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/knobCheck"
          }
        },
        "coverage": {
          "$ref": "#/definitions/coverage"
        }
      }
    },
    "latencySummary": {
      "description": "Percentiles with bootstrap confidence intervals; the value of each is in seconds.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p50_seconds",
        "p90_seconds",
        "p95_seconds",
        "p99_seconds"
      ],
      "properties": {
        "mean_seconds": {
          "type": "number",
          "minimum": 0
        },
        "max_seconds": {
          "type": "number",
          "minimum": 0
        },
        "p50_seconds": {
          "$ref": "../common.schema.json#/definitions/bootstrapInterval"
        },
        "p90_seconds": {
          "$ref": "../common.schema.json#/definitions/bootstrapInterval"
        },
        "p95_seconds": {
          "$ref": "../common.schema.json#/definitions/bootstrapInterval"
        },
        "p99_seconds": {
          "$ref": "../common.schema.json#/definitions/bootstrapInterval"
        }
      }
    },
    "errorClassCount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error_class",
        "count"
      ],
      "properties": {
        "error_class": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sloResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slo",
        "threshold",
        "is_met"
      ],
      "properties": {
        "slo": {
          "$ref": "../common.schema.json#/definitions/sloName"
        },
        "threshold": {
          "description": "The RunSpec threshold: seconds for the latency SLOs, a ratio for max_error_rate.",
          "type": "number",
          "minimum": 0
        },
        "observed": {
          "description": "The measured value in the same unit; absent when there were too few samples.",
          "type": "number",
          "minimum": 0
        },
        "is_met": {
          "type": "boolean"
        }
      }
    },
    "stageAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_index",
        "offered_rps",
        "achieved_rps",
        "requests",
        "errors"
      ],
      "properties": {
        "stage_index": {
          "type": "integer",
          "minimum": 0
        },
        "offered_rps": {
          "type": "number",
          "minimum": 0
        },
        "achieved_rps": {
          "type": "number",
          "minimum": 0
        },
        "goodput_rps": {
          "description": "Requests per second that met every SLO.",
          "type": "number",
          "minimum": 0
        },
        "requests": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "errors_by_class": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/errorClassCount"
          }
        },
        "ttft": {
          "$ref": "#/definitions/latencySummary"
        },
        "itl": {
          "$ref": "#/definitions/latencySummary"
        },
        "tpot": {
          "$ref": "#/definitions/latencySummary"
        },
        "e2e": {
          "$ref": "#/definitions/latencySummary"
        },
        "send_lag_p50_seconds": {
          "type": "number",
          "minimum": 0
        },
        "send_lag_p99_seconds": {
          "type": "number",
          "minimum": 0
        },
        "send_lag_max_seconds": {
          "type": "number",
          "minimum": 0
        },
        "input_tokens_per_second": {
          "type": "number",
          "minimum": 0
        },
        "output_tokens_per_second": {
          "type": "number",
          "minimum": 0
        },
        "total_tokens_per_second": {
          "type": "number",
          "minimum": 0
        },
        "slo_results": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/sloResult"
          }
        }
      }
    },
    "sloMaxRps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rps",
        "is_interpolated",
        "valid_stage_index"
      ],
      "properties": {
        "rps": {
          "type": "number",
          "minimum": 0
        },
        "is_interpolated": {
          "description": "True when rps lies between the valid stage and the failed one that brackets it; then failed_stage_index is required. failed_stage_index > valid_stage_index is a servtuner analyze self-check.",
          "type": "boolean"
        },
        "valid_stage_index": {
          "description": "Highest valid stage where every SLO holds.",
          "type": "integer",
          "minimum": 0
        },
        "failed_stage_index": {
          "description": "The bracketing stage that failed; absent when there is none.",
          "type": "integer",
          "minimum": 0
        },
        "limiting_slo": {
          "description": "The SLO that failed at the bracketing stage.",
          "$ref": "../common.schema.json#/definitions/sloName"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "is_interpolated": {
                "const": true
              }
            },
            "required": [
              "is_interpolated"
            ]
          },
          "then": {
            "required": [
              "failed_stage_index"
            ]
          }
        }
      ]
    },
    "kneeReason": {
      "type": "string",
      "enum": [
        "latency_slope",
        "queueing",
        "preemptions"
      ]
    },
    "bottleneckResource": {
      "description": "gpu_util is the weak fallback when DCGM profiling metrics are missing.",
      "type": "string",
      "enum": [
        "kv_cache",
        "gpu_engine_activity",
        "gpu_util",
        "cpu",
        "router_concurrency",
        "upstream_capacity"
      ]
    },
    "bottleneck": {
      "description": "The resource closest to its ceiling at the knee.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "utilization",
        "is_weak_signal"
      ],
      "properties": {
        "resource": {
          "$ref": "#/definitions/bottleneckResource"
        },
        "utilization": {
          "description": "How close to its ceiling the resource was at the knee.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "is_weak_signal": {
          "type": "boolean"
        }
      }
    },
    "knee": {
      "description": "Where headroom disappears. The bottleneck is judged here, so there is none without a knee.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_index",
        "reason"
      ],
      "properties": {
        "stage_index": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "$ref": "#/definitions/kneeReason"
        },
        "slope_ratio": {
          "description": "For latency_slope: how many times faster p95 latency grew than RPS; above 2 marks the knee.",
          "type": "number",
          "minimum": 0
        },
        "bottleneck": {
          "$ref": "#/definitions/bottleneck"
        }
      }
    },
    "perReplica": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready_replicas",
        "rps_per_replica"
      ],
      "properties": {
        "ready_replicas": {
          "description": "The minimum number of replicas ready during the window.",
          "type": "integer",
          "minimum": 1
        },
        "rps_per_replica": {
          "description": "SLO-max RPS divided by ready_replicas.",
          "type": "number",
          "minimum": 0
        },
        "total_gpus": {
          "description": "GPUs across the ready replicas.",
          "type": "integer",
          "minimum": 1
        },
        "rps_per_gpu": {
          "description": "SLO-max RPS divided by total_gpus.",
          "type": "number",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "rps_per_gpu"
            ]
          },
          "then": {
            "required": [
              "total_gpus"
            ]
          }
        }
      ]
    },
    "capacityModel": {
      "description": "Omitted members mean the run did not support the answer, for example no valid stage means no slo_max.",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "slo_max": {
          "$ref": "#/definitions/sloMaxRps"
        },
        "knee": {
          "$ref": "#/definitions/knee"
        },
        "per_replica": {
          "$ref": "#/definitions/perReplica"
        }
      }
    }
  }
}
