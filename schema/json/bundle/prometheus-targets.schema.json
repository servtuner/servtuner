{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://servtuner.dev/schema/bundle/prometheus-targets.schema.json",
  "title": "PrometheusTargets",
  "description": "prometheus/targets.json: the effective scrape interval and timeout of every scraped job, from /api/v1/targets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fetched_at",
    "targets"
  ],
  "properties": {
    "fetched_at": {
      "$ref": "../common.schema.json#/definitions/utcTimestamp"
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/scrapedJob"
      }
    }
  },
  "definitions": {
    "jobRole": {
      "description": "What the job scrapes; the stage-length rules use the slowest of target, cadvisor and dcgm.",
      "type": "string",
      "enum": [
        "target",
        "cadvisor",
        "kube_state_metrics",
        "dcgm",
        "other"
      ]
    },
    "scrapedJob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job",
        "role",
        "scrape_interval_seconds",
        "scrape_timeout_seconds"
      ],
      "properties": {
        "job": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "$ref": "#/definitions/jobRole"
        },
        "scrape_interval_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "scrape_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
