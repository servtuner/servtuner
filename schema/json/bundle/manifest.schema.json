{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://servtuner.dev/schema/bundle/manifest.schema.json",
  "title": "Manifest",
  "description": "manifest.json: written last, so the API never indexes a half-written bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_version", "run_id", "status", "started_at", "bench_version", "files"],
  "properties": {
    "bundle_version": { "description": "Changes only on a breaking change to the bundle layout. 2 (servtuner 0.2) records each hop's transport in environment.json as {tls, client_cert}; 1 (servtuner 0.1) recorded a mode string. Readers accept both.", "type": "integer", "enum": [1, 2] },
    "run_id": { "type": "string", "minLength": 1 },
    "name": { "description": "RunSpec name.", "type": "string", "minLength": 1 },
    "bench_version": { "type": "string", "minLength": 1 },
    "status": { "$ref": "#/definitions/runStatus" },
    "started_at": { "$ref": "../common.schema.json#/definitions/utcTimestamp" },
    "finished_at": { "$ref": "../common.schema.json#/definitions/utcTimestamp" },
    "error": { "$ref": "#/definitions/failure" },
    "storage": { "$ref": "#/definitions/bundleLocation" },
    "files": {
      "description": "Every other file in the bundle, with its checksum.",
      "type": "array",
      "items": { "$ref": "#/definitions/manifestFile" }
    }
  },
  "definitions": {
    "runStatus": { "type": "string", "enum": ["running", "collecting", "succeeded", "failed", "cancelled"] },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "message"],
      "properties": {
        "step": { "$ref": "../events.schema.json#/definitions/pipelineStep" },
        "message": { "type": "string" }
      }
    },
    "bundleLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store", "key"],
      "properties": {
        "store": { "description": "Name of the bundle store, never an endpoint.", "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "node_pinned": { "type": "boolean", "default": false }
      }
    },
    "manifestFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
