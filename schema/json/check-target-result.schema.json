{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://servtuner.dev/schema/check-target-result.schema.json",
  "title": "CheckTargetResult",
  "description": "servtuner check-target's output: one entry per check, in order. A check that depends on a failed one is skipped. status is failed when any check failed, warning when any warned, else ok. Never carries a secret value.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "checked_at", "target_type", "endpoint", "checks"],
  "properties": {
    "status": { "$ref": "#/definitions/checkStatus" },
    "checked_at": { "$ref": "common.schema.json#/definitions/utcTimestamp" },
    "target_type": { "$ref": "runspec.schema.json#/definitions/targetType" },
    "endpoint": { "type": "string", "minLength": 1 },
    "checks": { "type": "array", "items": { "$ref": "#/definitions/targetCheck" } }
  },
  "definitions": {
    "checkStatus": {
      "description": "The verdict of the whole check.",
      "type": "string",
      "enum": ["ok", "warning", "failed"]
    },
    "checkStepStatus": {
      "description": "skipped: not run, because a check it depends on failed or it does not apply (no Prometheus, no workload, generate not asked for).",
      "type": "string",
      "enum": ["ok", "warning", "failed", "skipped"]
    },
    "checkName": {
      "type": "string",
      "enum": ["resolve", "connect", "tls", "auth", "model", "generate", "metrics", "gpu_metrics", "workload"]
    },
    "targetCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "message", "duration_seconds"],
      "properties": {
        "name": { "$ref": "#/definitions/checkName" },
        "status": { "$ref": "#/definitions/checkStepStatus" },
        "message": { "description": "A sentence a user can act on.", "type": "string", "minLength": 1 },
        "duration_seconds": { "type": "number", "minimum": 0 }
      }
    }
  }
}
