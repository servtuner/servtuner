{
  "apiVersion": "servtuner.dev/v2",
  "kind": "RunSpec",
  "name": "sglang-baseline",
  "target": {
    "type": "sglang",
    "endpoint": "http://sglang.inference.svc:30000/v1",
    "model": "qwen2.5-0.5b-instruct",
    "workload": {
      "namespace": "inference",
      "selector": {
        "app.kubernetes.io/name": "sglang"
      }
    },
    "tls": {
      "enabled": false
    }
  },
  "engine": {
    "type": "loadgen"
  },
  "workload": {
    "api": "chat",
    "streaming": true,
    "dataset": {
      "type": "synthetic",
      "input_tokens": {
        "mean": 256,
        "stddev": 32
      },
      "output_tokens": {
        "mean": 128,
        "stddev": 16
      }
    }
  },
  "load": {
    "warmup": "30s",
    "stages": [
      {
        "rate": 2,
        "duration": "60s"
      },
      {
        "rate": 4,
        "duration": "60s"
      }
    ]
  },
  "prometheus": {
    "url": "http://prometheus.monitoring.svc:9090",
    "tls": {
      "enabled": false
    }
  }
}
