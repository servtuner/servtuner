{
  "apiVersion": "servtuner.dev/v2",
  "kind": "RunSpec",
  "name": "preset-multiturn-seeded",
  "target": {
    "type": "vllm",
    "endpoint": "https://vllm.inference.svc:8000/v1",
    "model": "example/model-8b",
    "tls": {
      "enabled": true,
      "clientCert": {
        "secretRef": {
          "name": "servtuner-client"
        }
      }
    }
  },
  "engine": {
    "type": "loadgen"
  },
  "workload": {
    "preset": "chat-multiturn@1",
    "streaming": true,
    "seed": 7
  },
  "load": {
    "stages": [
      {
        "rate": 1,
        "duration": "30s"
      },
      {
        "rate": 3,
        "duration": "20s",
        "is_burst": true
      }
    ],
    "pacing": "poisson"
  }
}
