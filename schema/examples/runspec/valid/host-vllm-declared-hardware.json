{
  "apiVersion": "servtuner.dev/v1",
  "kind": "RunSpec",
  "name": "vllm-lan-baseline",
  "knobs": {
    "vllm.gpu_memory_utilization": 0.75
  },
  "target": {
    "type": "vllm",
    "endpoint": "http://vllm-host.example:8080/v1",
    "model": "tiny",
    "auth": {
      "secretRef": {
        "name": "vllm-key",
        "key": "token"
      }
    },
    "metrics": {
      "namespace": "servtuner-external",
      "pod": "vllm-lan"
    },
    "tls": {
      "mode": "platform"
    },
    "hardware": {
      "host": "gpu-box",
      "accelerator": "NVIDIA GeForce RTX 3070",
      "gpu_count": 1,
      "gpu_memory_bytes": 8589934592,
      "cpu_cores": 16
    }
  },
  "engine": {
    "type": "loadgen"
  },
  "workload": {
    "api": "chat",
    "streaming": true,
    "dataset": {
      "type": "synthetic",
      "input_tokens": {
        "mean": 256,
        "stddev": 32
      },
      "output_tokens": {
        "mean": 128,
        "stddev": 16
      }
    }
  },
  "load": {
    "stages": [
      {
        "rate": 2,
        "duration": "60s"
      },
      {
        "rate": 8,
        "duration": "60s"
      }
    ]
  },
  "prometheus": {
    "url": "http://prometheus.monitoring.svc:9090",
    "tls": {
      "mode": "platform"
    }
  },
  "analysis": {
    "infra_pricing": {
      "source": "static",
      "static": {
        "gpus": {
          "NVIDIA GeForce RTX 3070": {
            "purchase_usd": 500,
            "amortization_hours": 8760,
            "watts": 220,
            "usd_per_kwh": 0.087
          }
        }
      }
    }
  }
}
