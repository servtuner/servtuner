{
  "apiVersion": "servtuner.dev/v1",
  "kind": "RunSpec",
  "name": "preset-resolved",
  "target": {
    "type": "vllm",
    "endpoint": "https://vllm.inference.svc:8000/v1",
    "model": "example/model-8b",
    "tls": {
      "mode": "mtls",
      "secretRef": {
        "name": "servtuner-client"
      }
    }
  },
  "engine": {
    "type": "loadgen"
  },
  "workload": {
    "streaming": true,
    "api": "chat",
    "dataset": {
      "type": "synthetic",
      "input_tokens": {
        "mean": 256,
        "stddev": 64
      },
      "output_tokens": {
        "mean": 256,
        "stddev": 64
      }
    }
  },
  "load": {
    "stages": [
      {
        "rate": 1,
        "duration": "30s"
      },
      {
        "rate": 3,
        "duration": "20s",
        "is_burst": true
      }
    ],
    "pacing": "poisson"
  },
  "workload_preset": {
    "name": "chat-short",
    "version": 1
  }
}
