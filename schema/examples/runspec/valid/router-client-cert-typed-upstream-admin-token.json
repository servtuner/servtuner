{
  "apiVersion": "servtuner.dev/v2",
  "kind": "RunSpec",
  "name": "bifrost-mtls-upstream-admin-token",
  "knobs": {
    "bifrost.concurrency": 1000
  },
  "target": {
    "type": "bifrost",
    "endpoint": "https://bifrost.gateway.svc:8080/v1",
    "model": "example/model-8b",
    "workload": {
      "namespace": "gateway",
      "selector": {
        "app": "bifrost"
      }
    },
    "upstreams": [
      {
        "name": "vllm-a",
        "type": "vllm",
        "endpoint": "https://vllm-a.inference.svc:8000/v1",
        "tls": {
          "enabled": true,
          "clientCert": {
            "secretRef": {
              "name": "servtuner-client"
            }
          }
        }
      },
      {
        "name": "mock-b",
        "tls": {
          "enabled": false
        }
      }
    ],
    "tls": {
      "enabled": true,
      "clientCert": {
        "secretRef": {
          "name": "servtuner-client"
        }
      }
    },
    "admin": {
      "secretRef": {
        "name": "bifrost-admin",
        "tokenKey": "token"
      }
    }
  },
  "engine": {
    "type": "loadgen"
  },
  "workload": {
    "api": "completion",
    "streaming": false,
    "dataset": {
      "type": "synthetic",
      "input_tokens": {
        "mean": 256,
        "stddev": 32
      },
      "output_tokens": {
        "mean": 128,
        "stddev": 16
      }
    }
  },
  "load": {
    "stages": [
      {
        "rate": 100,
        "duration": "60s"
      },
      {
        "rate": 500.5,
        "duration": "1m30s"
      }
    ],
    "warmup": "10s"
  },
  "prometheus": {
    "url": "http://prometheus.monitoring.svc:9090",
    "tls": {
      "enabled": false
    }
  }
}
