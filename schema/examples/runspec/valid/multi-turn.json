{
  "apiVersion": "servtuner.dev/v2",
  "kind": "RunSpec",
  "name": "multi-turn-chat",
  "target": {
    "type": "vllm",
    "endpoint": "https://vllm.inference.svc:8000/v1",
    "model": "example/model-8b",
    "tls": {
      "enabled": true,
      "clientCert": {
        "secretRef": {
          "name": "servtuner-client"
        }
      }
    }
  },
  "engine": {
    "type": "loadgen"
  },
  "workload": {
    "streaming": true,
    "dataset": {
      "type": "synthetic",
      "input_tokens": {
        "mean": 128
      },
      "output_tokens": {
        "mean": 64
      }
    },
    "conversation": {
      "turns": 4,
      "concurrent": 16
    }
  },
  "load": {
    "stages": [
      {
        "rate": 1,
        "duration": "30s"
      }
    ],
    "pacing": "poisson"
  }
}
